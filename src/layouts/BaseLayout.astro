---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** 宽版内容区（首页卡片网格用），文章页保持窄栏 */
  wide?: boolean;
}

const { title, description = siteConfig.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

/** 背景图：site.config.ts 里填了 image 才启用，否则纯白 */
const bg = siteConfig.background;
const bgUrl = bg.image
  ? `url("${import.meta.env.BASE_URL}${bg.image.replace(/^\//, '')}")`
  : 'none';
const bgUrlMobile = (bg.imageMobile ?? bg.image)
  ? `url("${import.meta.env.BASE_URL}${(bg.imageMobile ?? bg.image)!.replace(/^\//, '')}")`
  : 'none';
const bgStyle = [
  `--bg-image: ${bgUrl}`,
  `--bg-image-mobile: ${bgUrlMobile}`,
  `--bg-size: ${bg.size}`,
  `--bg-size-mobile: ${bg.sizeMobile ?? bg.size}`,
  `--bg-position: ${bg.position}`,
  `--bg-position-mobile: ${bg.positionMobile ?? bg.position}`,
  `--bg-overlay: ${bg.overlay}`,
  `--bg-attachment: ${bg.fixed ? 'fixed' : 'scroll'}`,
].join('; ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={`${import.meta.env.BASE_URL}rss.xml`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
  </head>
  <body style={bgStyle}>
    <Header />
    <main>
      <div class:list={['container', { 'container--wide': wide }]}>
        <slot />
      </div>
    </main>
    <Footer />
    <Assistant />
  </body>
</html>
